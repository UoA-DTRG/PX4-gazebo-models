<?xml version="1.0" encoding="UTF-8"?>
<!--
  Visual-only Vicon Vantage camera fixture.

  PLACEHOLDER: primitive stand-in for the mesh-based asset referenced by the
  DTRG motion-capture world. Replace the visuals with the meshes when the asset
  is delivered; the model frame below is what the world poses depend on, so keep
  it unchanged.

  Model frame: +X points along the optical axis toward the flight mat, +Z is up
  before the mounting pitch is applied. The origin sits behind the front face so
  that the world-level camera number display, placed at local (0.047, 0, -0.055),
  lands just proud of the lower front panel.

  This fixture generates no measurement: it is a landmark, not a sensor.
-->
<sdf version="1.9">
  <model name="vicon_vantage_visual">
    <static>true</static>
    <link name="camera_body">
      <visual name="housing">
        <pose>-0.09 0 0 0 0 0</pose>
        <geometry><box><size>0.26 0.20 0.17</size></box></geometry>
        <material><ambient>0.03 0.03 0.035 1</ambient><diffuse>0.07 0.07 0.08 1</diffuse><specular>0.20 0.20 0.20 1</specular></material>
      </visual>
      <visual name="strobe_bezel">
        <pose>0.038 0 0.015 0 1.57079632679 0</pose>
        <geometry><cylinder><radius>0.088</radius><length>0.014</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.055 1</ambient><diffuse>0.11 0.11 0.12 1</diffuse></material>
      </visual>
      <visual name="lens">
        <pose>0.047 0 0.015 0 1.57079632679 0</pose>
        <geometry><cylinder><radius>0.062</radius><length>0.014</length></cylinder></geometry>
        <material><ambient>0.08 0.30 0.55 1</ambient><diffuse>0.10 0.45 0.80 1</diffuse><specular>0.45 0.45 0.45 1</specular></material>
      </visual>
      <visual name="rail_bracket">
        <pose>-0.10 0 0.17 0 0 0</pose>
        <geometry><box><size>0.05 0.05 0.18</size></box></geometry>
        <material><ambient>0.20 0.21 0.22 1</ambient><diffuse>0.32 0.33 0.34 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
