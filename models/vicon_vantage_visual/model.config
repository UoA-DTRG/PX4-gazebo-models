<?xml version="1.0"?>
<model>
  <name>vicon_vantage_visual</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Visual-only stand-in for a Vicon Vantage motion-capture camera. Built from
    primitives because the mesh assets are not part of this checkout. The model
    carries no sensor and publishes no external-position measurement.
  </description>
</model>
