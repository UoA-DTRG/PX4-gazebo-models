<?xml version="1.0" encoding="UTF-8"?>
<!-- Created: 27/09/2026 -->
<!--
  planarOcto with a forward interaction rod.

  The airframe itself is planar_octo, merge-included rather than copied, so
  the CAD geometry, rotor poses, inertia, sensors and the eight motor plugins
  stay defined in one place. Only the rod is added here. Because the include
  is merged, base_link and the rotor_N links/joints keep their names and the
  PX4 gz_bridge sensor topics are unchanged; the 0.183 m ground offset of
  planar_octo is carried by the merge frame, so this model spawns at the same
  height as the plain vehicle.

  Rod geometry is ESTIMATED, not measured:
    shaft   0.016 m diameter, 0.35 m long, along body +X (forward);
    tip     0.018 m radius contact ball;
    reach   0.6155 m from the body centre, i.e. 0.368 m clear of the
            0.2475 m body collision radius.

  The rod is mounted at base_link z = 0, which is the height of the airframe
  centre of mass, so an axial contact force produces no pitching moment. Mass
  is ASSUMED at 0.030 kg (carbon tube plus tip and mount), modelled as a
  uniform rod. That is 2% of the 1.460 kg airframe and moves the combined
  centre of mass 8.5 mm forward, which the hover-thrust estimator and the
  position controller absorb; the 12013 airframe gains are left unchanged.
-->
<sdf version="1.9">
  <model name="planar_octo_rod">
    <include merge="true"><uri>model://planar_octo</uri></include>

    <!-- Local +Z runs along the rod, i.e. along body +X. -->
    <link name="interaction_rod">
      <pose relative_to="base_link">0.422500 0 0 0 1.57079632679 0</pose>
      <inertial>
        <mass>0.030</mass>
        <inertia><ixx>3.07e-4</ixx><ixy>0</ixy><ixz>0</ixz><iyy>3.07e-4</iyy><iyz>0</iyz><izz>1.0e-6</izz></inertia>
      </inertial>
      <visual name="rod_shaft">
        <geometry><cylinder><radius>0.008</radius><length>0.35</length></cylinder></geometry>
        <material><ambient>0.09 0.09 0.10 1</ambient><diffuse>0.17 0.17 0.19 1</diffuse><specular>0.35 0.35 0.35 1</specular></material>
      </visual>
      <visual name="rod_tip">
        <pose>0 0 0.175 0 0 0</pose>
        <geometry><sphere><radius>0.018</radius></sphere></geometry>
        <material><ambient>0.55 0.18 0.05 1</ambient><diffuse>0.92 0.34 0.08 1</diffuse><specular>0.40 0.40 0.40 1</specular></material>
      </visual>
      <visual name="rod_root_collar">
        <pose>0 0 -0.170 0 0 0</pose>
        <geometry><cylinder><radius>0.013</radius><length>0.020</length></cylinder></geometry>
        <material><ambient>0.30 0.31 0.33 1</ambient><diffuse>0.48 0.49 0.52 1</diffuse></material>
      </visual>
      <collision name="rod_shaft_collision">
        <geometry><cylinder><radius>0.008</radius><length>0.35</length></cylinder></geometry>
      </collision>
      <collision name="rod_tip_collision">
        <pose>0 0 0.175 0 0 0</pose>
        <geometry><sphere><radius>0.018</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction>
          <contact><ode><kp>1e6</kp><kd>60</kd></ode></contact>
        </surface>
      </collision>
      <!-- Contact detection for the tip; needs gz-sim-contact-system, which
           PX4's server.config loads for every world. This reports whether and
           where contact happened, not how hard: gz-sim leaves the contact
           message's wrench field at zero. The force comes from the
           force_torque sensor on interaction_rod_joint below. -->
      <sensor name="rod_tip_contact" type="contact">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <contact><collision>rod_tip_collision</collision></contact>
      </sensor>
    </link>
    <!--
      The rod mount, instrumented. The force_torque sensor measures the wrench
      the rod transmits into base_link, expressed in the parent (base_link)
      frame, which is body FLU. PX4's gz_bridge subscribes to

        /world/<world>/model/<model>/joint/interaction_rod_joint/sensor/interaction_force/forcetorque

      converts FLU to body FRD and publishes it as the interaction_wrench uORB
      topic, which the logger records into the ulog. Needs
      gz-sim-forcetorque-system, which PX4's server.config loads.

      Sign, verified in simulation by pushing the rod into a wall ahead of the
      vehicle: pressing forward gives a NEGATIVE force x in FRD, because the
      reported quantity is what the environment feeds back into the airframe,
      not what the vehicle exerts. The rod's own 0.030 kg weight and its
      inertial reaction during manoeuvres are included, so the reading is the
      external contact force only when the vehicle is near steady flight.
    -->
    <joint name="interaction_rod_joint" type="fixed">
      <parent>base_link</parent>
      <child>interaction_rod</child>
      <sensor name="interaction_force" type="force_torque">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <force_torque>
          <frame>parent</frame>
          <measure_direction>child_to_parent</measure_direction>
        </force_torque>
      </sensor>
    </joint>
  </model>
</sdf>
