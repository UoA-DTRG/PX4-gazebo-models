<?xml version="1.0" encoding="UTF-8"?>
<!-- Created: 28/10/2026 -->
<!--
  Ti-Tui (stacked octo) with a forward interaction rod.

  The same rod as planar_octo_rod, on the Ti-Tui. The airframe itself is
  ti_tui, merge-included rather than copied, so the CAD geometry, rotor poses,
  inertia, sensors and the eight motor plugins stay defined in one place. Only
  the rod is added here. Because the include is merged, base_link and the
  rotor_N links/joints keep their names and the PX4 gz_bridge sensor topics
  are unchanged; the 0.102 m ground offset of ti_tui is carried by the merge
  frame, so this model spawns at the same height as the plain vehicle.

  Rod geometry is ESTIMATED, not measured:
    shaft   0.016 m diameter, 0.35 m long, along body +X (forward);
    tip     0.018 m radius contact ball;
    root    x = 0.0725 m, the front face of the body collision box;
    reach   0.4405 m from the body centre, i.e. 0.28 m clear of the front
            propeller discs (0.159 m).

  The rod runs between the two front rotor pairs. The nearest propeller disc
  (upper rotors 0 and 1) comes to within 31 mm of the centre line, 23 mm from
  the rod surface.

  The rod is mounted at base_link z = 0, which is the height of the airframe
  centre of mass, so an axial contact force produces no pitching moment. Mass
  is ASSUMED at 0.030 kg (carbon tube plus tip and mount), modelled as a
  uniform rod.

  Uncompensated, the rod would move the combined centre of mass 6.0 mm
  forward, a 0.073 N m nose-down moment that is about 13% of the Ti-Tui's
  small pitch authority: with the integrators frozen on the ground that
  pitched the vehicle 13 deg nose down at liftoff, and it flipped against the
  pole. The include below therefore moves the base CoM aft so the vehicle CoM
  stays at the body origin, as it does on every *_rod model. The rod adds
  0.030 kg, 2.5% of the 1.21 kg airframe; the hover-thrust estimator takes
  that up and the 12011 airframe gains are left unchanged.
-->
<sdf version="1.9">
  <model name="ti_tui_rod">
    <include merge="true"><uri>model://ti_tui</uri>
      <!-- Rebalance: the base CoM moves aft so that base + rotors + rod keep
           the CoM at the body origin, the point the CA_ROTOR positions are
           measured from. Stands in for moving the battery aft; no mass is
           added. Written by Tools/dtrg/vehicle_properties/ti_tui_properties.py,
           which keeps it in step with the vehicle's mass and rotor links. -->
      <experimental:params>
        <link element_id="base_link" action="modify"><inertial><pose>-0.006335 0.000000 0.000005 0 0 0</pose></inertial></link>
      </experimental:params>
    </include>

    <!-- Local +Z runs along the rod, i.e. along body +X. -->
    <link name="interaction_rod">
      <pose relative_to="base_link">0.247500 0 0 0 1.57079632679 0</pose>
      <inertial>
        <mass>0.030</mass>
        <inertia><ixx>3.07e-4</ixx><ixy>0</ixy><ixz>0</ixz><iyy>3.07e-4</iyy><iyz>0</iyz><izz>1.0e-6</izz></inertia>
      </inertial>
      <visual name="rod_shaft">
        <geometry><cylinder><radius>0.008</radius><length>0.35</length></cylinder></geometry>
        <material><ambient>0.09 0.09 0.10 1</ambient><diffuse>0.17 0.17 0.19 1</diffuse><specular>0.35 0.35 0.35 1</specular></material>
      </visual>
      <visual name="rod_tip">
        <pose>0 0 0.175 0 0 0</pose>
        <geometry><sphere><radius>0.018</radius></sphere></geometry>
        <material><ambient>0.55 0.18 0.05 1</ambient><diffuse>0.92 0.34 0.08 1</diffuse><specular>0.40 0.40 0.40 1</specular></material>
      </visual>
      <visual name="rod_root_collar">
        <pose>0 0 -0.170 0 0 0</pose>
        <geometry><cylinder><radius>0.013</radius><length>0.020</length></cylinder></geometry>
        <material><ambient>0.30 0.31 0.33 1</ambient><diffuse>0.48 0.49 0.52 1</diffuse></material>
      </visual>
      <collision name="rod_shaft_collision">
        <geometry><cylinder><radius>0.008</radius><length>0.35</length></cylinder></geometry>
      </collision>
      <collision name="rod_tip_collision">
        <pose>0 0 0.175 0 0 0</pose>
        <geometry><sphere><radius>0.018</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction>
          <contact><ode><kp>1e6</kp><kd>60</kd></ode></contact>
        </surface>
      </collision>
      <!-- Contact detection for the tip; see planar_octo_rod. Reports where
           contact happened, not how hard. -->
      <sensor name="rod_tip_contact" type="contact">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <contact><collision>rod_tip_collision</collision></contact>
      </sensor>
    </link>
    <!--
      The rod mount, instrumented exactly as on planar_octo_rod. The joint and
      sensor names are what PX4's gz_bridge subscribes to:

        /world/<world>/model/<model>/joint/interaction_rod_joint/sensor/interaction_force/forcetorque

      It converts body FLU to body FRD and publishes the interaction_wrench
      uORB topic, which the logger records into the ulog. Pressing forward
      gives a NEGATIVE force x in FRD, and the reading includes the rod's own
      weight and inertial reaction (see planar_octo_rod).
    -->
    <joint name="interaction_rod_joint" type="fixed">
      <parent>base_link</parent>
      <child>interaction_rod</child>
      <sensor name="interaction_force" type="force_torque">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <force_torque>
          <frame>parent</frame>
          <measure_direction>child_to_parent</measure_direction>
        </force_torque>
      </sensor>
    </joint>
  </model>
</sdf>
