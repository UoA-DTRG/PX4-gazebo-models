<?xml version="1.0" encoding="UTF-8"?>
<!-- Author: Ishaq Hafez <ishaq.hafez@auckland.ac.nz> -->
<!-- Created: 15/09/2026 -->
<!-- Last Checked: 15/09/2026 -->
<!--
  DTRG Planar Octo motion-capture laboratory simulation world.

  Measured values supplied on 16 August 2026:
    rubber flight mat: 6 m by 6 m, formed from 1 m square tiles;
    safety enclosure: approximately 8 m by 8 m by 3 m.

  Visual estimates from the laboratory reference images:
    room envelope: 14 m by 11 m by 4.2 m, extended two metres behind
      the pilot/control side while preserving the measured flight area;
    doors, control area, ceiling details, camera rails, and Vicon camera poses.

  The vicon_vantage_visual mesh assets are not present in this checkout, so the
  enclosure rail, camera-support rail, and camera number displays are primitive
  stand-ins. Each is marked PLACEHOLDER below.

  The estimated values define the initial geometric representation and must
  be replaced when measured values become available. The Vicon camera fixtures
  are visual references; they do not generate external-position measurements.
-->
<sdf version="1.9">
  <world name="mocap">
    <!--
      GUI configuration. Gazebo replaces its entire default gui.config when a
      world supplies a <gui> element, so the standard plugin set is reproduced
      here; only camera_pose, ambient_light and background_color are changed.
      The view starts inside the room at (-6.0 -3.0 2.3) on the pilot side,
      outside the 8 m enclosure, aimed at the vehicle on the mat.
    -->
    <gui fullscreen="0">
      <!-- Window -->
      <window>
        <width>1000</width>
        <height>845</height>
        <style
          material_theme="Light"
          material_primary="DeepOrange"
          material_accent="LightBlue"
          toolbar_color_light="#f3f3f3"
          toolbar_text_color_light="#111111"
          toolbar_color_dark="#414141"
          toolbar_text_color_dark="#f3f3f3"
          plugin_toolbar_color_light="#bbdefb"
          plugin_toolbar_text_color_light="#111111"
          plugin_toolbar_color_dark="#607d8b"
          plugin_toolbar_text_color_dark="#eeeeee"
        />
        <menus>
          <drawer default="false">
          </drawer>
        </menus>
        <dialog_on_exit>true</dialog_on_exit>
      </window>

      <!-- GUI plugins -->

      <!-- 3D scene -->
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>

        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.75 0.75 0.73</ambient_light>
        <background_color>0.91 0.93 0.96</background_color>
        <camera_pose>-6.0 -3.0 2.3 0 0.303 0.464</camera_pose>
      </plugin>

      <!-- Plugins that add functionality to the scene -->
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="MarkerManager" name="Marker manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="SelectEntities" name="Select Entities">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="Spawn" name="Spawn Entities">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <!-- World control -->
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="z">1</property>

          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>

        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>true</start_paused>
        <use_event>true</use_event>

      </plugin>

      <!-- World statistics -->
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>

          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>

        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <!-- Insert simple shapes -->
      <plugin filename="Shapes" name="Shapes">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">0</property>
          <property key="y" type="double">0</property>
          <property key="width" type="double">300</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#666666</property>
        </gz-gui>
      </plugin>

      <!-- Insert lights -->
      <plugin filename="Lights" name="Lights">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">300</property>
          <property key="y" type="double">0</property>
          <property key="width" type="double">150</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#666666</property>
        </gz-gui>
      </plugin>

      <!-- Translate / rotate -->
      <plugin filename="TransformControl" name="Transform control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">0</property>
          <property key="y" type="double">50</property>
          <property key="width" type="double">250</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#777777</property>
        </gz-gui>
      </plugin>

      <!-- Screenshot -->
      <plugin filename="Screenshot" name="Screenshot">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">250</property>
          <property key="y" type="double">50</property>
          <property key="width" type="double">50</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#777777</property>
        </gz-gui>
      </plugin>

      <!-- Copy/Paste -->
      <plugin filename="CopyPaste" name="CopyPaste">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">300</property>
          <property key="y" type="double">50</property>
          <property key="width" type="double">100</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#777777</property>
        </gz-gui>
      </plugin>

      <!-- Inspector -->
      <plugin filename="ComponentInspector" name="Component inspector">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>

      <!-- Entity tree -->
      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>
    </gui>

    <physics name="physics_4_ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Preserve the verified Step 06 sensor and environment baseline. -->
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <wind>
      <linear_velocity>0 0 0</linear_velocity>
    </wind>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <scene>
      <grid>false</grid>
      <ambient>0.75 0.75 0.73 1</ambient>
      <background>0.91 0.93 0.96 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="main_ceiling_light" type="directional">
      <pose>0 0 4 0 0 0</pose>
      <direction>-0.15 0.25 -1</direction>
      <diffuse>0.85 0.85 0.81 1</diffuse>
      <specular>0.18 0.18 0.18 1</specular>
      <cast_shadows>false</cast_shadows>
    </light>
    <light name="light_negative_x_negative_y" type="point">
      <pose>-2.5 -2.5 3.75 0 0 0</pose>
      <diffuse>0.92 0.92 0.87 1</diffuse>
      <specular>0.10 0.10 0.10 1</specular>
      <attenuation><range>12</range><constant>0.7</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light name="light_negative_x_positive_y" type="point">
      <pose>-2.5 2.5 3.75 0 0 0</pose>
      <diffuse>0.92 0.92 0.87 1</diffuse>
      <specular>0.10 0.10 0.10 1</specular>
      <attenuation><range>12</range><constant>0.7</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light name="light_positive_x_negative_y" type="point">
      <pose>2.5 -2.5 3.75 0 0 0</pose>
      <diffuse>0.92 0.92 0.87 1</diffuse>
      <specular>0.10 0.10 0.10 1</specular>
      <attenuation><range>12</range><constant>0.7</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light name="light_positive_x_positive_y" type="point">
      <pose>2.5 2.5 3.75 0 0 0</pose>
      <diffuse>0.92 0.92 0.87 1</diffuse>
      <specular>0.10 0.10 0.10 1</specular>
      <attenuation><range>12</range><constant>0.7</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <!--
      The world datum is the rubber mat surface, not the laboratory floor:
      the 0.024 m mat thickness is taken up by this model offset so that the
      flight surface sits at z = 0, as PX4 assumes when it spawns a vehicle
      without PX4_GZ_MODEL_POSE. The lab floor therefore sits at z = -0.024.
      All measured dimensions are unchanged; only the reference plane moved.
    -->
    <model name="motion_capture_laboratory">
      <pose>0 0 -0.024 0 0 0</pose>
      <static>true</static>
      <link name="laboratory_structure">
        <!--
          Closed room shell: estimated 14 m by 11 m by 4.2 m. The +X wall
          remains at +6 m; the pilot-side -X wall is extended from -6 to -8 m.
          Wall collisions and visuals remain opaque; the enlarged pilot-side
          space permits a wider useful view without transparent-corner artefacts.
        -->
        <collision name="floor_collision">
          <pose>-1 0 -0.05 0 0 0</pose>
          <geometry><box><size>14 11 0.1</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <pose>-1 0 -0.05 0 0 0</pose>
          <geometry><box><size>14 11 0.1</size></box></geometry>
          <material>
            <ambient>0.72 0.73 0.72 1</ambient>
            <diffuse>0.78 0.79 0.78 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>

        <collision name="wall_positive_x_collision">
          <pose>6 0 2.1 0 0 0</pose>
          <geometry><box><size>0.15 11 4.2</size></box></geometry>
        </collision>
        <visual name="wall_positive_x_visual">
          <pose>6 0 2.1 0 0 0</pose>
          <geometry><box><size>0.15 11 4.2</size></box></geometry>
          <material><ambient>0.88 0.88 0.85 1</ambient><diffuse>0.94 0.94 0.91 1</diffuse></material>
        </visual>
        <collision name="wall_negative_x_collision">
          <pose>-8 0 2.1 0 0 0</pose>
          <geometry><box><size>0.15 11 4.2</size></box></geometry>
        </collision>
        <visual name="wall_negative_x_visual">
          <pose>-8 0 2.1 0 0 0</pose>
          <geometry><box><size>0.15 11 4.2</size></box></geometry>
          <material><ambient>0.88 0.88 0.85 1</ambient><diffuse>0.94 0.94 0.91 1</diffuse></material>
        </visual>
        <collision name="wall_positive_y_collision">
          <pose>-1 5.5 2.1 0 0 0</pose>
          <geometry><box><size>14 0.15 4.2</size></box></geometry>
        </collision>
        <visual name="wall_positive_y_visual">
          <pose>-1 5.5 2.1 0 0 0</pose>
          <geometry><box><size>14 0.15 4.2</size></box></geometry>
          <material><ambient>0.88 0.88 0.85 1</ambient><diffuse>0.94 0.94 0.91 1</diffuse></material>
        </visual>
        <collision name="wall_negative_y_collision">
          <pose>-1 -5.5 2.1 0 0 0</pose>
          <geometry><box><size>14 0.15 4.2</size></box></geometry>
        </collision>
        <visual name="wall_negative_y_visual">
          <pose>-1 -5.5 2.1 0 0 0</pose>
          <geometry><box><size>14 0.15 4.2</size></box></geometry>
          <material><ambient>0.88 0.88 0.85 1</ambient><diffuse>0.94 0.94 0.91 1</diffuse></material>
        </visual>
        <collision name="ceiling_collision">
          <pose>-1 0 4.2 0 0 0</pose>
          <geometry><box><size>14 11 0.1</size></box></geometry>
        </collision>
        <visual name="ceiling_visual">
          <pose>-1 0 4.2 0 0 0</pose>
          <geometry><box><size>14 11 0.1</size></box></geometry>
          <material><ambient>0.82 0.82 0.80 1</ambient><diffuse>0.92 0.92 0.90 1</diffuse></material>
        </visual>

        <!-- Yellow ceiling border visible around the safety enclosure. -->
        <visual name="yellow_ceiling_positive_x">
          <pose>4.45 0 4.11 0 0 0</pose>
          <geometry><box><size>0.9 9 0.06</size></box></geometry>
          <material><ambient>0.62 0.48 0.05 1</ambient><diffuse>0.82 0.66 0.10 1</diffuse></material>
        </visual>
        <visual name="yellow_ceiling_negative_x">
          <pose>-4.45 0 4.11 0 0 0</pose>
          <geometry><box><size>0.9 9 0.06</size></box></geometry>
          <material><ambient>0.62 0.48 0.05 1</ambient><diffuse>0.82 0.66 0.10 1</diffuse></material>
        </visual>
        <visual name="yellow_ceiling_positive_y">
          <pose>0 4.45 4.11 0 0 0</pose>
          <geometry><box><size>8 0.9 0.06</size></box></geometry>
          <material><ambient>0.62 0.48 0.05 1</ambient><diffuse>0.82 0.66 0.10 1</diffuse></material>
        </visual>
        <visual name="yellow_ceiling_negative_y">
          <pose>0 -4.45 4.11 0 0 0</pose>
          <geometry><box><size>8 0.9 0.06</size></box></geometry>
          <material><ambient>0.62 0.48 0.05 1</ambient><diffuse>0.82 0.66 0.10 1</diffuse></material>
        </visual>

        <!-- Illuminated ceiling panels. -->
        <visual name="ceiling_light_1"><pose>-2.5 -2.5 4.06 0 0 0</pose><geometry><box><size>1.2 0.3 0.03</size></box></geometry><material><ambient>1 1 0.96 1</ambient><diffuse>1 1 0.96 1</diffuse><emissive>0.8 0.8 0.76 1</emissive></material></visual>
        <visual name="ceiling_light_2"><pose>-2.5 2.5 4.06 0 0 0</pose><geometry><box><size>1.2 0.3 0.03</size></box></geometry><material><ambient>1 1 0.96 1</ambient><diffuse>1 1 0.96 1</diffuse><emissive>0.8 0.8 0.76 1</emissive></material></visual>
        <visual name="ceiling_light_3"><pose>0 -2.5 4.06 0 0 0</pose><geometry><box><size>1.2 0.3 0.03</size></box></geometry><material><ambient>1 1 0.96 1</ambient><diffuse>1 1 0.96 1</diffuse><emissive>0.8 0.8 0.76 1</emissive></material></visual>
        <visual name="ceiling_light_4"><pose>0 2.5 4.06 0 0 0</pose><geometry><box><size>1.2 0.3 0.03</size></box></geometry><material><ambient>1 1 0.96 1</ambient><diffuse>1 1 0.96 1</diffuse><emissive>0.8 0.8 0.76 1</emissive></material></visual>
        <visual name="ceiling_light_5"><pose>2.5 -2.5 4.06 0 0 0</pose><geometry><box><size>1.2 0.3 0.03</size></box></geometry><material><ambient>1 1 0.96 1</ambient><diffuse>1 1 0.96 1</diffuse><emissive>0.8 0.8 0.76 1</emissive></material></visual>
        <visual name="ceiling_light_6"><pose>2.5 2.5 4.06 0 0 0</pose><geometry><box><size>1.2 0.3 0.03</size></box></geometry><material><ambient>1 1 0.96 1</ambient><diffuse>1 1 0.96 1</diffuse><emissive>0.8 0.8 0.76 1</emissive></material></visual>

        <!-- Major ceiling vents visible in the laboratory photographs. -->
        <visual name="ceiling_vent_negative_x_negative_y"><pose>-3.3 -1.7 4.055 0 0 0</pose><geometry><box><size>0.65 0.65 0.035</size></box></geometry><material><ambient>0.24 0.25 0.25 1</ambient><diffuse>0.34 0.35 0.35 1</diffuse></material></visual>
        <visual name="ceiling_vent_positive_x_positive_y"><pose>3.1 1.8 4.055 0 0 0</pose><geometry><box><size>0.65 0.65 0.035</size></box></geometry><material><ambient>0.24 0.25 0.25 1</ambient><diffuse>0.34 0.35 0.35 1</diffuse></material></visual>

        <!-- Measured 6 m by 6 m rubber mat with 1 m tile divisions. -->
        <collision name="rubber_mat_collision">
          <pose>0 0 0.012 0 0 0</pose>
          <geometry><box><size>6 6 0.024</size></box></geometry>
        </collision>
        <visual name="rubber_mat_visual">
          <pose>0 0 0.012 0 0 0</pose>
          <geometry><box><size>6 6 0.024</size></box></geometry>
          <material>
            <ambient>0.24 0.25 0.27 1</ambient>
            <diffuse>0.34 0.35 0.38 1</diffuse>
            <specular>0.03 0.03 0.03 1</specular>
          </material>
        </visual>
        <visual name="tile_x_negative_2"><pose>-2 0 0.027 0 0 0</pose><geometry><box><size>0.012 6 0.006</size></box></geometry><material><ambient>0.42 0.43 0.45 1</ambient><diffuse>0.42 0.43 0.45 1</diffuse></material></visual>
        <visual name="tile_x_negative_1"><pose>-1 0 0.027 0 0 0</pose><geometry><box><size>0.012 6 0.006</size></box></geometry><material><ambient>0.42 0.43 0.45 1</ambient><diffuse>0.42 0.43 0.45 1</diffuse></material></visual>
        <visual name="tile_x_0"><pose>0 0 0.027 0 0 0</pose><geometry><box><size>0.012 6 0.006</size></box></geometry><material><ambient>0.42 0.43 0.45 1</ambient><diffuse>0.42 0.43 0.45 1</diffuse></material></visual>
        <visual name="tile_x_positive_1"><pose>1 0 0.027 0 0 0</pose><geometry><box><size>0.012 6 0.006</size></box></geometry><material><ambient>0.42 0.43 0.45 1</ambient><diffuse>0.42 0.43 0.45 1</diffuse></material></visual>
        <visual name="tile_x_positive_2"><pose>2 0 0.027 0 0 0</pose><geometry><box><size>0.012 6 0.006</size></box></geometry><material><ambient>0.42 0.43 0.45 1</ambient><diffuse>0.42 0.43 0.45 1</diffuse></material></visual>
        <visual name="tile_y_negative_2"><pose>0 -2 0.027 0 0 0</pose><geometry><box><size>6 0.012 0.006</size></box></geometry><material><ambient>0.42 0.43 0.45 1</ambient><diffuse>0.42 0.43 0.45 1</diffuse></material></visual>
        <visual name="tile_y_negative_1"><pose>0 -1 0.027 0 0 0</pose><geometry><box><size>6 0.012 0.006</size></box></geometry><material><ambient>0.42 0.43 0.45 1</ambient><diffuse>0.42 0.43 0.45 1</diffuse></material></visual>
        <visual name="tile_y_0"><pose>0 0 0.027 0 0 0</pose><geometry><box><size>6 0.012 0.006</size></box></geometry><material><ambient>0.42 0.43 0.45 1</ambient><diffuse>0.42 0.43 0.45 1</diffuse></material></visual>
        <visual name="tile_y_positive_1"><pose>0 1 0.027 0 0 0</pose><geometry><box><size>6 0.012 0.006</size></box></geometry><material><ambient>0.42 0.43 0.45 1</ambient><diffuse>0.42 0.43 0.45 1</diffuse></material></visual>
